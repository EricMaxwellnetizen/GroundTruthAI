# GroundTruth configuration. Copy to .env, then edit locally. Never commit .env.
# Fixture mode needs no credentials or network access.

# App
GROUNDTRUTH_MODE=fixture
GROUNDTRUTH_LOG_LEVEL=INFO
GROUNDTRUTH_DATABASE_URL=sqlite:///./groundtruth.db
GROUNDTRUTH_MAX_SCAN_SECONDS=180
GROUNDTRUTH_MAX_PAGES=20
GROUNDTRUTH_PAGE_SIZE=100
GROUNDTRUTH_REQUEST_TIMEOUT_SECONDS=20
GROUNDTRUTH_MAX_RETRIES=3
GROUNDTRUTH_REDACT_ACCOUNT_IDS=true
GROUNDTRUTH_UI_SYNC=false
GROUNDTRUTH_DEBUG=false

# Demo fixture paths (defaults point at the synthetic data in this repository)
GROUNDTRUTH_DEMO_REPO_PATH=
GROUNDTRUTH_FIXTURES_DIR=

# AWS (read-only; prefer SSO or an assumed role)
AWS_PROFILE=
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1

# Scalr (use a read-only token)
SCALR_BASE_URL=https://your-account.scalr.io
SCALR_API_TOKEN=
# Required free-form filter[tf-resource-usage] value from your Scalr API schema
SCALR_TF_RESOURCE_USAGE_FILTER=
SCALR_PAGE_SIZE=100

# Git and optional GitLab
GIT_REPO_PATH=
GITLAB_BASE_URL=https://gitlab.com
GITLAB_PROJECT_ID=
GITLAB_TOKEN=

# Meta Muse Spark (explanation is advisory; deterministic engine owns status)
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
AI_ENABLED=false

# CloudWatch Omni (optional; link/context only)
CLOUDWATCH_OMNI_URL=
CLOUDWATCH_OMNI_SPACE=

# CloudTrail / CloudWatch lookback windows
GROUNDTRUTH_CLOUDTRAIL_LOOKBACK_DAYS=90
GROUNDTRUTH_CLOUDWATCH_LOOKBACK_DAYS=14
GROUNDTRUTH_CLOUDWATCH_PERIOD_SECONDS=300

# Optional MCP servers (JSON list). Default deny unless tools are explicitly allowlisted.
GROUNDTRUTH_MCP_SERVERS=[]
GROUNDTRUTH_MCP_ALLOWLIST=
